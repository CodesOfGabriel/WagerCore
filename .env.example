# Defaults de desenvolvimento. Em production, configure OIDC HTTPS explicitamente,
# deixe SQS_ENDPOINT vazio e use a cadeia de credenciais AWS (sem credenciais test).
# O Compose local lê as opções de pool/workers abaixo; ambiente, portas,
# endpoints e credenciais dos containers são definidos na própria composição.
APP_ENV=local
HTTP_ADDR=:8080
DATABASE_URL=postgres://jungle:jungle@localhost:5432/jungle?sslmode=disable
DATABASE_MAX_CONNECTIONS=10
HEALTH_TIMEOUT=2s
OIDC_ISSUER_URL=http://localhost:8081/realms/wagercore
OIDC_JWKS_URL=http://localhost:8081/realms/wagercore/protocol/openid-connect/certs
OIDC_AUDIENCE=wagercore-api
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
WORKER_ROLES=all
WORKER_CONCURRENCY=4
WORKER_INTERVAL=200ms
DLQ_POLL_INTERVAL=30s
LEASE_DURATION=30s
SQS_VISIBILITY_TIMEOUT=30
REFERENCE_TTL=10m
REFERENCE_MAX_ATTEMPTS=10
RETRY_BASE=1s
TEST_DATABASE_URL=postgres://jungle_test:jungle_test@localhost:55432/jungle_test?sslmode=disable
TEST_OIDC_ISSUER_URL=http://localhost:58081/realms/wagercore
TEST_SQS_ENDPOINT=http://localhost:54566
